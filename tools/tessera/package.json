{
  "name": "tessera",
  "version": "0.1.0",
  "private": true,
  "description": "Tiled Claude Code terminals in one window",
  "license": "Apache-2.0",
  "type": "module",
  "main": "src/main/main.js",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "watch": "node build.mjs --watch",
    "test": "node --test test/*.test.js",
    "dist": "node build.mjs && electron-builder --publish never"
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "node-pty@1.1.0": true,
    "electron-winstaller": false
  },
  "build": {
    "appId": "dev.tessera.app",
    "productName": "Tessera",
    "npmRebuild": false,
    "directories": {
      "output": "dist/release"
    },
    "files": [
      "package.json",
      "src/**",
      "bin/**",
      "dist/app/**",
      "!dist/app/**/*.map"
    ],
    "asarUnpack": [
      "bin/**",
      "src/cli/**",
      "node_modules/node-pty/**"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": "AppImage",
      "category": "Development"
    }
  }
}
